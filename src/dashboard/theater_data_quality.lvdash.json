{
  "datasets": [
    {
      "name": "ds_dq_overall_latest",
      "displayName": "DQ Summary - Latest Run (Overall)",
      "queryLines": [
        "WITH s AS (\n",
        "  SELECT *\n",
        "  FROM IDENTIFIER(:catalog || '.' || :gold_schema || '.dq_summary')\n",
        "  WHERE dimension = 'overall'\n",
        ")\n",
        "SELECT dataset, dimension, rows_input, rows_accepted, rows_rejected, rejection_rate, as_of\n",
        "FROM s\n",
        "WHERE as_of = (SELECT MAX(as_of) FROM s)"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "theater_management"
                }
              ]
            }
          }
        },
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "gold"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_dq_pos_breakdown_latest",
      "displayName": "DQ Summary - Latest Run (Per POS System)",
      "queryLines": [
        "WITH s AS (\n",
        "  SELECT *\n",
        "  FROM IDENTIFIER(:catalog || '.' || :gold_schema || '.dq_summary')\n",
        "  WHERE dataset = 'pos_ticket_sales' AND dimension != 'overall'\n",
        ")\n",
        "SELECT dimension AS pos_source, rows_input, rows_accepted, rows_rejected, rejection_rate\n",
        "FROM s\n",
        "WHERE as_of = (SELECT MAX(as_of) FROM s)"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "theater_management"
                }
              ]
            }
          }
        },
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "gold"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_dq_rejection_reasons_latest",
      "displayName": "DQ Rejection Reasons - Latest Run (POS)",
      "queryLines": [
        "WITH r AS (\n",
        "  SELECT *\n",
        "  FROM IDENTIFIER(:catalog || '.' || :gold_schema || '.dq_rejection_reasons')\n",
        "  WHERE dataset = 'pos_ticket_sales'\n",
        ")\n",
        "SELECT pos_source, rejection_reason, count, reason_rate\n",
        "FROM r\n",
        "WHERE as_of = (SELECT MAX(as_of) FROM r)"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "theater_management"
                }
              ]
            }
          }
        },
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "gold"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_dq_freshness",
      "displayName": "DQ Freshness by Dataset",
      "queryLines": [
        "SELECT\n",
        "  dataset,\n",
        "  MAX(as_of) AS last_run_at,\n",
        "  ROUND(TIMESTAMPDIFF(MINUTE, MAX(as_of), CURRENT_TIMESTAMP()) / 60.0, 1) AS hours_since_last_run\n",
        "FROM IDENTIFIER(:catalog || '.' || :gold_schema || '.dq_summary')\n",
        "WHERE dimension = 'overall'\n",
        "GROUP BY dataset"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "theater_management"
                }
              ]
            }
          }
        },
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "gold"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_dq_trend",
      "displayName": "DQ Rejection Rate Trend (All Runs)",
      "queryLines": [
        "SELECT dataset, as_of, rejection_rate\n",
        "FROM IDENTIFIER(:catalog || '.' || :gold_schema || '.dq_summary')\n",
        "WHERE dimension = 'overall'\n",
        "ORDER BY as_of"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "theater_management"
                }
              ]
            }
          }
        },
        {
          "displayName": "gold_schema",
          "keyword": "gold_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "gold"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_dq_pending_review",
      "displayName": "DQ Rows Pending Review (Correction Feedback Loop)",
      "queryLines": [
        "SELECT COUNT(*) AS pending_count\n",
        "FROM IDENTIFIER(:catalog || '.' || :silver_schema || '.pos_quality_issues')\n",
        "WHERE resolution_status = 'PENDING_REVIEW'"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "theater_management"
                }
              ]
            }
          }
        },
        {
          "displayName": "silver_schema",
          "keyword": "silver_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "silver"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_dq_corrected",
      "displayName": "DQ Rows Resolved via Correction Feedback Loop",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) FILTER (WHERE is_corrected) AS corrected_count,\n",
        "  COUNT(*) FILTER (WHERE is_manually_approved) AS approved_count\n",
        "FROM IDENTIFIER(:catalog || '.' || :silver_schema || '.stg_pos_ticket_sales')"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "theater_management"
                }
              ]
            }
          }
        },
        {
          "displayName": "silver_schema",
          "keyword": "silver_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "silver"
                }
              ]
            }
          }
        }
      ]
    }
  ],
